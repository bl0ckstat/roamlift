[Unit]
Description=RoamLift workout tracker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=duncan
WorkingDirectory=/home/duncan/repos/roamlift
ExecStart=/home/duncan/repos/roamlift/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8484
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
